# Pooled connection for the app at runtime (Neon host contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"

# Direct connection for Prisma migrations (Neon host does not contain -pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
